<Project>
  <Import Project="$(MSBuildThisFileDirectory)local.private.props" Condition="Exists('$(MSBuildThisFileDirectory)local.private.props')" />
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <Product>SI Desk</Product>
    <Company>SI Desk</Company>
    <Authors>SI Desk</Authors>
    <Copyright>Copyright (c) SI Desk</Copyright>
    <Version>0.3.66</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)-desk-foundation</InformationalVersion>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</RepoRoot>
  </PropertyGroup>
</Project>

