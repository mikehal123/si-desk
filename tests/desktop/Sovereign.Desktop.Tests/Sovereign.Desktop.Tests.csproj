<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Sovereign.Desktop.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\apps\desktop\Sovereign.Desktop.Updates\Sovereign.Desktop.Updates.csproj" />
    <ProjectReference Include="..\..\..\apps\desktop\Sovereign.Desktop.Core\Sovereign.Desktop.Core.csproj" />
    <ProjectReference Include="..\..\..\apps\desktop\Sovereign.Desktop.Client\Sovereign.Desktop.Client.csproj" />
    <ProjectReference Include="..\..\..\apps\desktop\Sovereign.Desktop.Presentation\Sovereign.Desktop.Presentation.csproj" />
    <ProjectReference Include="..\..\..\apps\desktop\Sovereign.Desktop.SetupLib\Sovereign.Desktop.SetupLib.csproj" />
    <ProjectReference Include="..\Sovereign.Desktop.G3Harness\Sovereign.Desktop.G3Harness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\fixtures\desktop\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\..\contracts\observed\**\*" CopyToOutputDirectory="PreserveNewest" Link="contracts\observed\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\..\..\contracts\observed')" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="$(PrivateTestsCompileRemove)" Condition="'$(PrivateTestsCompileRemove)' != ''" />
  </ItemGroup>
</Project>
