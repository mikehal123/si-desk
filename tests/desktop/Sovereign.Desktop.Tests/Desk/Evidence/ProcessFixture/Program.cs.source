using System.Text;
using System.Text.Json;
using System.Security.Cryptography;

// Fault executable is a separate test project. None of these modes ship in the extraction helper.
internal static class Program
{
    public static async Task<int> Main(string[] args)
    {
        if (args.Single() == "exit-early") return 55;
        var input = await Console.In.ReadToEndAsync();
        switch (args.Single())
        {
            case "hang": await Task.Delay(Timeout.Infinite); return 0;
            case "malformed": Console.Write("{broken"); return 0;
            case "oversized":
            case "stderr":
                var stream = args[0] == "stderr" ? Console.OpenStandardError() : Console.OpenStandardOutput();
                var chunk = Encoding.UTF8.GetBytes(new string('x', 8192));
                for (var i = 0; i < 200; i++) await stream.WriteAsync(chunk);
                await Task.Delay(Timeout.Infinite);
                return 0;
            case "wrong-binding":
            case "bad-hash":
            case "bad-locator":
                using (var document = JsonDocument.Parse(input))
                {
                    var root = document.RootElement;
                    var original = Convert.FromBase64String(root.GetProperty("bytes").GetString()!);
                    var hash = Convert.ToHexStringLower(SHA256.HashData(original));
                    var parameters = new
                    {
                        case_id = args[0] == "wrong-binding" ? Guid.NewGuid() : root.GetProperty("case_id").GetGuid(),
                        expected_revision_id = root.GetProperty("expected_revision_id").GetGuid(),
                        session_nonce = root.GetProperty("session_nonce").GetGuid(), operation_id = root.GetProperty("operation_id").GetGuid(),
                        display_name = root.GetProperty("display_name").GetString(), media_type = "application/pdf", extraction_version = "pdfpig-text-v1",
                        original_sha256 = args[0] == "bad-hash" ? new string('0', 64) : hash,
                        original_base64 = Convert.ToBase64String(original), normalized_base64 = "eA==",
                        normalized_sha256 = Convert.ToHexStringLower(SHA256.HashData("x"u8.ToArray())),
                        quality_flags = Array.Empty<string>(),
                        locators = new[] { new { page = 1, section = (string?)null, start_character = 0, end_character = args[0] == "bad-locator" ? 2 : 1 } }
                    };
                    Console.Write(JsonSerializer.Serialize(new { version = 1, parameters, error_code = (string?)null, error_message = (string?)null }));
                }
                return 0;
            case "allocate":
                try
                {
                    var blocks = new List<byte[]>();
                    for (var i = 0; i < 64; i++)
                    {
                        var block = new byte[8 * 1024 * 1024];
                        Array.Fill(block, (byte)1);
                        blocks.Add(block);
                    }
                    GC.KeepAlive(blocks);
                    Console.Write("unbounded");
                    return 0;
                }
                catch (OutOfMemoryException) { return 73; }
            default: return 2;
        }
    }
}
